{
  "name": "livepix-plugin",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Plugin LivePix para o gerenciador de pacotes do OSC Flow Studio 0.5.0",
  "repository": { "type": "git", "url": "https://github.com/OSC-Flow-Studio/livepix-plugin.git" },
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node --check plugin/index.mjs && npm run validate && npm test",
    "prepackage": "npm run check",
    "package": "node sdk/ofs-package.mjs pack plugin --out dist",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "devDependencies": { "ajv": "8.17.1", "ajv-formats": "3.0.1" }
}
