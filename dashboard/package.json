{
  "name": "osc-livepix-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OSC LivePix Dashboard: receives LivePix webhooks and relays donations to the OSC Flow Studio plugin",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "dev:db": "node scripts/pglite-server.mjs 5433 .pglite",
    "build": "prisma generate && node --run build:web && node --run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "prisma generate && tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.5",
    "@hono/node-server": "1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
