# Copy to .env and fill in. Docker Compose reads the same file.

# Public origin of the dashboard. The webhook, API and WebSocket URLs shown to users start with it.
PUBLIC_URL=https://livepix.maned.club
PORT=3000

# Postgres. With docker compose the app reaches the "db" service; outside Docker use localhost.
POSTGRES_USER=livepix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=livepix
DATABASE_URL=postgresql://livepix:change-me@db:5432/livepix

# Signs sessions. At least 32 characters: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Encrypts the LivePix client secrets stored in the database. Exactly 32 bytes:
# openssl rand -hex 32
# Changing it makes every saved Client Secret unreadable; users would have to enter them again.
ENCRYPTION_KEY=

# "false" closes sign-up after your own account exists.
ALLOW_SIGNUP=true

# LivePix endpoints. Only change them to point at a test double.
LIVEPIX_API_BASE=https://api.livepix.gg/v2/
LIVEPIX_TOKEN_URL=https://oauth.livepix.gg/oauth2/token
