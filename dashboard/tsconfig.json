{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@/*": [
        "./web/src/*"
      ]
    }
  },
  "include": [
    "server/src",
    "server/generated",
    "tests",
    "prisma.config.ts"
  ]
}